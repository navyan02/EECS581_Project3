tracks/1/type = "method"
tracks/1/imported = false
tracks/1/enabled = true
tracks/1/path = NodePath(".")
tracks/1/interp = 1
tracks/1/loop_wrap = true
tracks/1/keys = {
"times": PackedFloat32Array(1, 2.1666667, 6.3, 9.9, 13.733334, 17.466667, 21.666666, 26.066668, 30.466667),
"transitions": PackedFloat32Array(1, 1, 1, 1, 1, 1, 1, 1, 1),
"values": [{
"args": ["Alien: Hey you!", 0.0],
"method": &"_show_dialog"
}, {
"args": ["Alien: Don't worry, Kevin sent me! I also sympathize with Earthlings.", 0.0],
"method": &"_show_dialog"
}, {
"args": ["Alien: I came to ask for help.", 0.0],
"method": &"_show_dialog"
}, {
"args": ["Henry: ... Why do you need *our* help?", 0.0],
"method": &"_show_dialog"
}, {
"args": ["Alien: I know you want to get rid of us so we don't take over Earth", 0.0],
"method": &"_show_dialog"
}, {
"args": ["Alien: But please don't kill my people. ", 0.0],
"method": &"_show_dialog"
}, {
"args": ["Alien: If you can buy me some time I'll try to convince our leaders to find a better planet. ", 0.0],
"method": &"_show_dialog"
}, {
"args": ["Alien: I want you to go to the control room and change the ship's destination to Mars. ", 0.0],
"method": &"_show_dialog"
}, {
"args": ["Alien: I'll distract the guards. I believe in you, Intern!", 0.0],
"method": &"_show_dialog"
}]
}

