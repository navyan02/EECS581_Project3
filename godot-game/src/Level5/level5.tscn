"times": PackedFloat32Array(0.1, 2.0333333, 6.9666667, 12.033334),
"transitions": PackedFloat32Array(1, 1, 1, 1),
"values": [{
"args": ["Henry: We're free!", 3.0],
"method": &"_show_dialog"
}, {
"args": ["Henry: Quick! We need to change their destination. The aliens seem to be oblivious.", 5.0],
"method": &"_show_dialog"
}, {
"args": ["Henry: I think if we change their destination, they will follow their navigational systems. ", 5.0],
"method": &"_show_dialog"
}, {
"args": ["Henry: There's a toxic planet that we can trick them into going to. Here are the coords!", 0.0],
"method": &"_show_dialog"
}]
}

